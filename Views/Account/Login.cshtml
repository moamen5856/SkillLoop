@using SkillLoop2.ViewModels;
@model LoginViewModel;


@{
    ViewData["Title"] = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<body>

    <div class="container">
        <main class="login-container">
            <p class="welcome-back">WELCOME BACK</p>
            <h1>Login to your account<span class="blue-dot">.</span></h1>
            <p class="member-text">New to SkillLoop? <a asp-controller="Account" asp-action="Register" class="signup-link">Sign Up</a></p>

            <form class="login-form" asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="field-error"></div>
                <div class="input-group">
                    <input asp-for="Email" type="email" id="email"  placeholder="Email address">
                    <i class="fas fa-envelope"></i>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>


                <div class="input-group">
                    <input asp-for="Password" type="password" id="password" name="password" placeholder="Password">
                    <i class="fas fa-eye toggle-password"></i>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>
                <div class="input-group">
                    <label class="form-check-label">
                        <input asp-for="RememberMe" class="form-check-input check">
                        @Html.DisplayNameFor(a=> a.RememberMe)
                    </label>
                </div>

                <div class="form-actions">
                    <a asp-controller="Account" asp-action="VerifyEmail" class="forgot-password">Forgot Password?</a>
                    <button type="submit" value="Login" class="login-button">Login</button>
                </div>
            </form>
        </main>


    </div>

    </div>
</body>
</html>

