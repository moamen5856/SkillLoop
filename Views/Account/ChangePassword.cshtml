@using SkillLoop2.ViewModels;
@model ChangePasswordViewModel;


@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">
<body>

    <div class="container">
        <main class="login-container">
            <h2>Change<span class="blue-dot"> Password</span></h2>

            <br>

            <form class="login-form" asp-action="ChangePassword" method="post">
                <div class="input-group">
                    <input asp-for="Email"  id="email" readonly>
                    <i class="fas fa-envelope"></i>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>
                <div class="input-group">
                    <input asp-for="NewPassword" placeholder="New Password">
                    <i class="fas fa-eye toggle-password"></i>
                    <span asp-validation-for="NewPassword" class="field-error"></span>
                </div>
                <div class="input-group">
                    <input asp-for="ConfirmNewPassword" placeholder="Confirm New Password">
                    <i class="fas fa-eye toggle-password"></i>
                    <span asp-validation-for="ConfirmNewPassword" class="field-error"></span>
                </div>



                <div class="form-actions">
                    <a asp-controller="Account" asp-action="VerifyEmail">Back</a>
                    <button type="submit" value="Submit" class="login-button">Login</button>
                </div>
            </form>
        </main>


    </div>

    </div>
</body>
</html>

