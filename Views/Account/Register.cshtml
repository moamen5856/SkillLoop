@using SkillLoop2.ViewModels;
@model RegisterViewModel;


@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!DOCTYPE html>
<html lang="en">

<body>

    <div class="container">

        <main class="signup-container">
            <p class="start-free">START FOR FREE</p>
            <h1>Create new account<span class="blue-dot">.</span></h1>
            <p class="member-text">Already A Member? <a asp-controller="Account" asp-action="Login" class="login-link">Log In</a></p>

            <form class="signup-form" asp-action="Register">
                    <div class="input-group">
                        <input type="text" asp-for="Name" placeholder="Name..">
                        <i class="fas fa-user"></i>
                    <span asp-validation-for="Name" class="field-error"></span>

                    </div>

                <div class="input-group">
                    <input asp-for="Email" type="email" id="email" placeholder="Email address">
                    <i class="fas fa-envelope"></i>
                    <span asp-validation-for="Email" class="field-error"></span>
                </div>

                <div class="input-group">
                    <input asp-for="Password" type="password" id="password" name="password" placeholder="Password">
                    <i class="fas fa-eye toggle-password"></i>
                    <span asp-validation-for="Password" class="field-error"></span>
                </div>

                <div class="input-group">
                    <input asp-for="ConfirmPassword" type="password"  placeholder="Password">
                    <i class="fas fa-eye toggle-password"></i>
                    <span asp-validation-for="ConfirmPassword" class="field-error"></span>
                </div>

                <div class="form-actions">
                    <button type="submit" value="Register" class="create-account">Create account</button>
                </div>
            </form>
        </main>


    </div>
    <script src="/Script/signup.js"></script>

</body>
</html>
