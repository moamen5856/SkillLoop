@model IEnumerable<SkillLoop2.Models.Category>

@{
    ViewData["Title"] = "Index";

    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 1;
    var totalItems = ViewData["TotalItems"] as int? ?? 0;
    var currentSort = ViewData["CurrentSort"] as string ?? "date_desc";

    int maxPagesToShow = 3;
    int startPage = 1;
    int endPage = totalPages;

    if (totalPages > maxPagesToShow)
    {
        if (currentPage <= (maxPagesToShow / 2) + 1)
        {
            startPage = 1;
            endPage = maxPagesToShow;
        }
        else if (currentPage >= totalPages - (maxPagesToShow / 2))
        {
            startPage = totalPages - maxPagesToShow + 1;
            endPage = totalPages;
        }
        else
        {
            startPage = currentPage - (maxPagesToShow / 2);
            endPage = currentPage + (maxPagesToShow / 2);
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/WebProjects.css" />
</head>
<body>
        <main id="main">

        <div class="content-projects">

            <div class="projects-container">
                @foreach (var category in Model)
                {
                    <div class="project-card">
                        <div class="project-content" data-type="@category.CategoryName.ToLower().Replace(" ", "-")">
                            <h3 class="project-title">@category.CategoryName</h3>
                            <a asp-action="IndexID" asp-controller="Projects" asp-route-id="@category.CategoryId" class="project-btn">
                                Details
                            </a>
                        </div>
                    </div>
                }
            </div>


            <nav aria-label="Page navigation">
                <ul class="pagination">
                    <!-- Skip -5 -->
                    <li class="page-item skip @(currentPage - 5 < 1 ? "disabled" : "")">
                        @if (currentPage - 5 < 1)
                        {
                            <a href="#" tabindex="-5" class="skip-btn">&lt;&lt;</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@(currentPage - 5)" class="skip-btn">&lt;&lt;</a>
                        }
                    </li>
                    <!-- Previous -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        @if (currentPage == 1)
                        {
                            <a href="#" tabindex="-1" class="skip-btn">&lt;</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@(currentPage - 1)" class="skip-btn">&lt;</a>
                        }
                    </li>
                    <!-- First page and ... -->
                    @if (startPage > 1)
                    {
                        <li class="page-item">
                            <a asp-action="Index" asp-route-page="1">1</a>
                        </li>
                        @if (startPage > 2)
                        {
                            <li class="page-item disabled"><span>...</span></li>
                        }
                    }
                    <!-- Page Numbers -->
                    @for (int i = startPage; i <= endPage; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a asp-action="Index" asp-route-page="@i" class="@(i == currentPage ? "active" : "")">@i</a>
                        </li>
                    }
                    <!-- ... and last page -->
                    @if (endPage < totalPages)
                    {
                        if (endPage < totalPages - 1)
                        {
                            <li class="page-item disabled"><span>...</span></li>
                        }
                        <li class="page-item">
                            <a asp-action="Index" asp-route-page="@totalPages">@totalPages</a>
                        </li>
                    }
                    <!-- Next -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        @if (currentPage == totalPages)
                        {
                            <a href="#" tabindex="-1" class="skip-btn">&gt;</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@(currentPage + 1)" class="skip-btn">&gt;</a>
                        }
                    </li>
                    <!-- Skip +5 -->
                    <li class="page-item skip @(currentPage + 5 > totalPages ? "disabled" : "")">
                        @if (currentPage + 5 > totalPages)
                        {
                            <a href="#" tabindex="-5" class="skip-btn">&gt;&gt;</a>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@(currentPage + 5)" class="skip-btn">&gt;&gt;</a>
                        }
                    </li>
                </ul>
            </nav>
            </div>
    </main>
</body>
</html>

